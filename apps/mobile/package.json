{
  "name": "@parkshield/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "^3.4.0",
    "@formatjs/intl-locale": "^5.5.0",
    "@formatjs/intl-pluralrules": "^7.1.0",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "intl-messageformat": "^12.2.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-firebase/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|expo-router|react-navigation|@react-navigation/.*|socket\\.io-client|intl-messageformat|@formatjs/.*|engine\\.io-client))"
    ],
    "moduleNameMapper": {
      "^@parkshield/i18n$": "<rootDir>/../../packages/i18n/src/index.ts",
      "^@parkshield/shared/(.*)$": "<rootDir>/../../packages/shared/src/$1",
      "^intl-messageformat$": "<rootDir>/node_modules/intl-messageformat"
    }
  }
}
