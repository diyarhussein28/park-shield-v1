{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@parkshield/i18n": ["../../packages/i18n/src/index.ts"],
      "@parkshield/shared/*": ["../../packages/shared/src/*"],
      "intl-messageformat": ["./node_modules/intl-messageformat"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
