# Single-server test stack. DOMAIN, BASIC_AUTH_USER and BASIC_AUTH_HASH come from .env.
# The whole site sits behind basic auth because this stack runs with APP_ENV=ci, which enables the
# dev inbox (/dev/postfach) and other test-only routes. Open without it: provider webhooks (Twilio and
# Stripe cannot send basic auth; they are verified by their own signatures) and the public scanner
# flow (see below).
{
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=63072000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Access log keeps method, status and timing only: no client IP, headers or URL (tokens live in URLs).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Ops routes never exist on the public API (AD-01); reject as a second layer.
	# (A bare `respond` would run after the `handle` blocks below, so it is wrapped in its own handle.)
	@ops path /ops/*
	handle @ops {
		respond 404
	}

	@webhooks path /v1/webhooks/*
	handle @webhooks {
		reverse_proxy 127.0.0.1:4000
	}

	# The scanner flow is public in production as well (rate limits + captcha protect it), and the
	# scan page fetches with credentials 'omit' (no cookies, no basic auth), so it stays open here:
	# the scan page, the owner's reply page, their API routes and the static build files.
	@scanner_api path /v1/scan/* /v1/alerts/* /v1/ack /v1/ack/*
	handle @scanner_api {
		reverse_proxy 127.0.0.1:4000
	}
	@scanner_web path /s/* /antwort /antwort/* /_next/*
	handle @scanner_web {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		handle /v1/* {
			reverse_proxy 127.0.0.1:4000
		}
		handle {
			reverse_proxy 127.0.0.1:3000
		}
	}
}
