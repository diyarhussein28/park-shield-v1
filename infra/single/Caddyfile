# Single-server test stack. DOMAIN, BASIC_AUTH_USER and BASIC_AUTH_HASH come from .env.
# The whole site sits behind basic auth because this stack runs with APP_ENV=ci, which enables the
# dev inbox (/dev/postfach) and other test-only routes. Open without it: provider webhooks (Twilio and
# Stripe cannot send basic auth; they are verified by their own signatures) and the public scanner
# flow (see below).
{
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	tls {
		# TLS 1.2 + 1.3 (2026-11-23): mail image proxies (Yahoo) still connect with TLS 1.2 and showed
		# no logo; old phones scanning a decal benefit too. TLS 1.2 is limited to forward-secret AEAD
		# suites (BSI TR-02102-2, ASVS V9.1); TLS 1.3 suites are fixed by Go and always strong.
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
	header {
		Strict-Transport-Security "max-age=63072000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Access log keeps method, status and timing only: no client IP, headers or URL (tokens live in URLs).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Ops routes never exist on the public API (AD-01); reject as a second layer.
	# (A bare `respond` would run after the `handle` blocks below, so it is wrapped in its own handle.)
	@ops path /ops/*
	handle @ops {
		respond 404
	}

	@webhooks path /v1/webhooks/*
	handle @webhooks {
		reverse_proxy 127.0.0.1:4000
	}

	# The scanner flow is public in production as well (rate limits + captcha protect it), and the
	# scan page fetches with credentials 'omit' (no cookies, no basic auth), so it stays open here:
	# the scan page, the owner's reply page, their API routes and the static build files.
	# The live chat socket (/v1/socket.io, WebSocket or polling), the trusted contacts' links (/v1/contacts/*,
	# token-protected like /v1/ack) and the native app's API (/v1/app/*: the app cannot send basic auth;
	# every route there needs a session or a rate-limited sign-in, see apps/api/src/security/routes.test.ts).
	# The native app shows the whole customer portal and sends its session as a bearer token; it cannot
	# send basic auth. Such API calls go straight to the API, which checks the session on every owner
	# route (SessionGuard). A made-up bearer header only reaches routes that are public in production too.
	@app_bearer {
		path /v1/*
		header Authorization "Bearer *"
	}
	handle @app_bearer {
		reverse_proxy 127.0.0.1:4000
	}

	@scanner_api path /v1/auth/email/* /v1/scan/* /v1/alerts/* /v1/ack /v1/ack/* /v1/socket.io /v1/socket.io/* /v1/contacts/* /v1/app/* /v1/auth/logout /v1/billing/subscription /v1/vehicles /v1/emergency-contact-invitations/*
	handle @scanner_api {
		reverse_proxy 127.0.0.1:4000
	}
	# /v/*: the owner's photo view link from a notification (Phase 2), token-protected like /antwort.
	# /auth/open: the bridge page of the app's sign-in e-mail (never signs in on load);
	# /k/*: a trusted contact's escalation link; /app/*: the app's sign-in link and alert deep links when
	# the app is not installed; /.well-known/*: Universal Links / App Links verification;
	# /email/*: the logo in our e-mails (public static file, no data);
	# /scanner-assets/*: the scan page's live chat client and captcha SDK (public static files, no data;
	# without it the page asked for basic auth after „Senden“ and the chat could not load, 2026-11-26).
	# /favicon.ico, /icons/*, /manifest.webmanifest: the site icons (public static files, no data). Chrome
	# fetches them for history and address-bar suggestions without basic auth; the 401 kept the old cached
	# shield next to test.park-shield.de (2026-11-28, docs/handover.md §31).
	@scanner_web path /auth/open /s/* /antwort /antwort/* /v/* /k/* /app/* /notfallkontakt /.well-known/* /_next/* /email/* /scanner-assets/* /favicon.ico /icons/* /manifest.webmanifest
	handle @scanner_web {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		handle /v1/* {
			reverse_proxy 127.0.0.1:4000
		}
		handle {
			reverse_proxy 127.0.0.1:3000
		}
	}
}

# The public website on the real domain (2026-11-24, replaces the Vercel preview). Until go-live
# (docs/status.md §1 step 5) this stack runs in test mode (APP_ENV=ci, dev inbox, test data), so only
# the public pages are served here, exactly what the Vercel preview showed: landing page, help centre,
# legal pages, their static files, the e-mail images (/email/*, also used by the Webmail signatures)
# and the app-link files. Everything else (sign-in, portal, scanner, /v1 API, /dev) redirects to the
# home page. PUBLIC_DOMAIN in .env (park-shield.de); unset, the block answers only on the local name
# public.localhost (Caddy's internal CA, no certificate request). At go-live this block is replaced by
# the full site: DOMAIN=park-shield.de with APP_ENV=production and no basic auth.
www.{$PUBLIC_DOMAIN:public.localhost} {
	redir https://{$PUBLIC_DOMAIN:public.localhost}{uri} permanent
}

{$PUBLIC_DOMAIN:public.localhost} {
	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
	header {
		Strict-Transport-Security "max-age=63072000"
		# Out of search engines until the lawyer has reviewed the legal pages (was SITE_NOINDEX on Vercel).
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	@website path / /app /business /hilfe /hilfe/* /impressum /datenschutz /agb /widerruf /barrierefreiheit /sicherheit /_next/* /email/* /images/* /icons/* /manifest.webmanifest /favicon.ico /icon /icon.* /apple-icon /apple-icon.* /robots.txt /sitemap.xml /.well-known/*
	handle @website {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		redir * / 302
	}
}

# Back office on its own subdomain (TEST STACK ONLY, docs/status.md §4): basic auth in front, then
# staff passkeys. OPS_BASE_URL in server.env must be https://{$OPS_DOMAIN}, because passkeys bind to
# that host. Only the ops app (:3001) is proxied; it forwards /ops/v1/* to the ops API itself.
# Production keeps the ops app off the internet (VPN only, AD-01): remove this block before go-live.
{$OPS_DOMAIN} {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=63072000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy 127.0.0.1:3001
}
