services:
  valkey:
    image: valkey/valkey:{{ valkey_version }}
    # AOF persistence; PostgreSQL stays the source of truth (escalations are re-scheduled by the sweeper).
    command: >-
      valkey-server --appendonly yes --appendfsync everysec --requirepass "{{ valkey_password }}"
      --masterauth "{{ valkey_password }}" --protected-mode yes
    ports: ["{{ ansible_host }}:6379:6379"]
    volumes: ["valkey-data:/data"]
    restart: unless-stopped
  worker:
    image: {{ registry }}/parkshield-api:{{ release }}
    command: ["node", "dist/worker.js"]
    env_file: app.env
    depends_on: [valkey]
    restart: unless-stopped
    read_only: true

volumes:
  valkey-data:
