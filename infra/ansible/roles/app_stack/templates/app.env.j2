NODE_ENV=production
APP_ENV={{ env_name }}
DATABASE_URL=postgres://{{ postgres_app_user }}:{{ postgres_app_password | urlencode }}@{{ hostvars[groups['db'] | select('search', 'primary') | first].ansible_host }}:5432/{{ postgres_db }}?sslmode=require
VALKEY_URL=redis://:{{ valkey_password | urlencode }}@{{ hostvars[groups['worker'][0]].ansible_host }}:6379/0
SCANNER_BASE_URL=https://{{ domain_scanner }}
WEB_BASE_URL=https://{{ domain_web }}
OPS_BASE_URL=https://{{ domain_ops }}
API_HOST=0.0.0.0
API_PORT=4000
OPS_API_HOST={{ wireguard_network | ansible.utils.ipaddr('1') | ansible.utils.ipaddr('address') }}
OPS_API_PORT=4001
{% for key, value in app_env.items() %}
{{ key }}={{ value }}
{% endfor %}
