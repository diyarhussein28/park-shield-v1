{
	servers {
		listener_wrappers {
			proxy_protocol {
				allow {{ private_network }}
			}
			tls
		}
		protocols h1 h2 h3
	}
}

(hardening) {
	tls {
		# TLS 1.2 + 1.3 (2026-11-23): mail image proxies (Yahoo) still connect with TLS 1.2 and showed
		# no logo; old phones scanning a decal benefit too. TLS 1.2 is limited to forward-secret AEAD
		# suites (BSI TR-02102-2, ASVS V9.1); TLS 1.3 suites are fixed by Go and always strong.
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
	# Ops routes exist only on api-ops behind the VPN; reject here as a second layer (AD-01).
	@ops path /ops/*
	respond @ops 404
	# Access log keeps method, status and timing only: no client IP, headers or URL (tokens live in URLs).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}

{{ domain_scanner }} {
	import hardening
	handle /v1/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

{{ domain_web }} {
	import hardening
	handle /v1/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
