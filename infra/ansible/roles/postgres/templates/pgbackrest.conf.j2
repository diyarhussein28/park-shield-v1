[global]
repo1-type=s3
repo1-s3-endpoint={{ s3_endpoint }}
repo1-s3-region={{ s3_region }}
repo1-s3-bucket={{ pgbackrest_bucket }}
repo1-s3-key={{ s3_access_key }}
repo1-s3-key-secret={{ s3_secret_key }}
repo1-s3-uri-style=path
repo1-path=/{{ env_name }}
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ pgbackrest_cipher_pass }}
repo1-retention-full-type=time
repo1-retention-full={{ pgbackrest_retention_days }}
process-max=2
compress-type=zst
start-fast=y
log-level-console=info

[main]
pg1-path=/var/lib/postgresql/{{ postgres_version }}/main
