# Generated from `terraform output -json private_ips` by infra/scripts/inventory.sh.
# Hosts are addressed by private IP; Ansible connects through the WireGuard tunnel.
all:
  vars:
    ansible_user: root
    env_name: staging
  children:
    app:
      hosts:
        ps-staging-app-1: { ansible_host: 10.10.1.2 }
    worker:
      hosts:
        ps-staging-worker-1: { ansible_host: 10.10.1.3 }
    db:
      hosts:
        ps-staging-db-primary: { ansible_host: 10.10.1.4, db_role: primary, db_device: /dev/disk/by-id/scsi-0HC_Volume_1 }
        ps-staging-db-replica: { ansible_host: 10.10.1.5, db_role: replica, db_device: /dev/disk/by-id/scsi-0HC_Volume_2 }
    tools:
      hosts:
        ps-staging-tools-1: { ansible_host: 10.10.1.6 }
