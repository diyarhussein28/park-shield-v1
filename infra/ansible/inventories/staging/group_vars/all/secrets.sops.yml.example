# Copy to secrets.sops.yml and encrypt: sops --encrypt --age <recipient> --in-place secrets.sops.yml
# Application keys (DATA_KEY_V1 etc.) must never pass through CI in readable form (02-architecture §2).
postgres_app_password: change-me
postgres_replication_password: change-me
postgres_metabase_password: change-me
pgbackrest_cipher_pass: change-me
pgdata_luks_key: change-me
valkey_password: change-me
grafana_admin_password: change-me
unleash_db_password: change-me
zammad_db_password: change-me
s3_access_key: change-me
s3_secret_key: change-me
wireguard_private_key: change-me
wireguard_peers: []
#  - name: techlead
#    public_key: ...
#    address: 10.20.0.10
alert_telegram_bot_token: change-me
app_env: {}
#  DATA_KEY_V1: ...
#  BIDX_KEY: ...
#  STRIPE_SECRET_KEY: ...
#  # US-42: audit stream to the Object Lock bucket (terraform output: audit bucket name)
#  AUDIT_BUCKET: parkshield-staging-audit
#  S3_ENDPOINT: https://fsn1.your-objectstorage.com
#  S3_REGION: fsn1
#  S3_ACCESS_KEY: ...   # a key that may only PUT/GET/LIST in the audit bucket
#  S3_SECRET_KEY: ...
