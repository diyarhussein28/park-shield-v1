{
  "name": "parkshield",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "db:start": "tsx scripts/db.ts",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback",
    "db:check": "tsx scripts/db-check.ts",
    "ops:invite": "tsx scripts/ops-invite.ts",
    "load:seed": "tsx scripts/load-seed.ts",
    "load:report": "tsx scripts/load-report.ts",
    "load:peak": "k6 run load/k6/peak.js",
    "chaos:drill": "tsx scripts/chaos-drill.ts",
    "db:restore-drill": "tsx scripts/restore-drill.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file apps/api/src/db/types.generated.ts",
    "build": "turbo run build --env-mode=loose",
    "lint": "turbo run lint --env-mode=loose",
    "typecheck": "turbo run typecheck --env-mode=loose",
    "test": "turbo run test --env-mode=loose --concurrency=1",
    "e2e": "npm run e2e -w @parkshield/e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2",
    "wait-on": "^9.0.0",
    "dbmate": "^2.38.1",
    "dotenv": "^18.0.10",
    "embedded-postgres": "18.6.0-beta.19",
    "kysely": "^0.29.8",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "web-push": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "esbuild@0.28.2": true
  }
}
