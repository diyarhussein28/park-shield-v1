# ParkShield local environment. `npm run dev` copies this to .env on first run and
# generates the local secrets marked (generated). Never commit .env.

# --- Local runtime -----------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://parkshield:parkshield@127.0.0.1:5432/parkshield?sslmode=disable
TEST_DATABASE_URL=postgres://parkshield:parkshield@127.0.0.1:5432/parkshield_test?sslmode=disable
# Memurai (Redis 7.2-compatible) on 6380 locally; Valkey 8 in staging/production.
VALKEY_URL=redis://127.0.0.1:6380/0

# --- Public URLs -------------------------------------------------------------
# Decal URLs are SCANNER_BASE_URL/s/<code>. Production: https://park-shield.de
SCANNER_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
OPS_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
API_PORT=4000
# api-ops binds here only (WireGuard interface in production).
OPS_API_HOST=127.0.0.1
OPS_API_PORT=4001

# --- Application secrets (generated locally; from SOPS/Infisical in prod) -----
DATA_KEY_V1=
BIDX_KEY=
BLOCK_KEY_CURRENT=
BLOCK_KEY_PREVIOUS=
SESSION_SECRET=
# Pepper for phone hashes of verified scanners (abuse protection). Never rotate: bans would be lost.
PHONE_PEPPER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@park-shield.de

# --- Provider sandbox keys (fill in yourself; empty = local fake adapter) ----
# Stripe test mode: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_YEARLY=
# Monthly prices (annual / 12, tax-inclusive) used after the first year for consumers
STRIPE_PRICE_MONTHLY=
# E-mail: mailjet (EU, default; tracking off), brevo or sendgrid. Empty key = local dev inbox.
MAIL_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
# global (api.sendgrid.com) or eu (api.eu.sendgrid.com, needs an EU subuser)
SENDGRID_REGION=global
MAIL_FROM=ParkShield <contact@park-shield.de>
# Native app push: Firebase Cloud Messaging HTTP v1 (iOS through APNs via FCM). A service account of
# the Firebase project. Empty = local fake (pushes in the dev inbox, /dev/postfach).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The private key of the service account, on one line with its line breaks written as backslash-n.
FCM_PRIVATE_KEY=
# SMS (Twilio). Empty keys = local fake (messages in the dev inbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: alphanumeric sender ID (max. 11 chars, e.g. ParkShield), a Twilio number or MG... SID
TWILIO_SMS_FROM=
# Twilio Verify service SID (VA...) for the optional scanner phone check in Protected Mode
TWILIO_VERIFY_SERVICE_SID=
# Public https origin Twilio calls back (tunnel or real domain); empty = WEB_BASE_URL
TWILIO_WEBHOOK_BASE_URL=
# Universal Links / App Links of the native app (website /.well-known/*); empty = no app yet.
APP_IOS_TEAM_ID=
APP_IOS_BUNDLE_ID=de.parkshield.app
APP_ANDROID_PACKAGE=de.parkshield.app
APP_ANDROID_SHA256=
# Friendly Captcha (the web app needs the sitekey too, as NEXT_PUBLIC_…)
FRIENDLY_CAPTCHA_SITEKEY=
FRIENDLY_CAPTCHA_API_KEY=
NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=
# eu (default; Friendly Captcha Advanced plan, required in production) or global (local testing on smaller plans)
FRIENDLY_CAPTCHA_ENDPOINT=eu
# Print partner (chosen in Phase 0). Empty = local fake: print files land in .local/print-outbox
PRINT_PARTNER=
PRINT_OUTBOX_DIR=
# Phase 2: optional photos with alerts (plans: setting photos.plans, default Plus and Premium). Off until
# the legal review is done. The E2E photo test (e2e/tests/alert-photos.spec.ts) needs it on.
ALERT_PHOTOS_ENABLED=false
# Encrypted photo files; empty = .local/alert-media (dev) or /var/lib/parkshield/alert-media (production).
# Never inside a web root, never in a backup.
ALERT_MEDIA_DIR=
# Optional
SENTRY_DSN=
UNLEASH_URL=
UNLEASH_API_TOKEN=
