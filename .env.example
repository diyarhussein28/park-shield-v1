# ParkShield local environment. `npm run dev` copies this to .env on first run and
# generates the local secrets marked (generated). Never commit .env.

# --- Local runtime -----------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://parkshield:parkshield@127.0.0.1:5432/parkshield?sslmode=disable
TEST_DATABASE_URL=postgres://parkshield:parkshield@127.0.0.1:5432/parkshield_test?sslmode=disable
# Memurai (Redis 7.2-compatible) on 6380 locally; Valkey 8 in staging/production.
VALKEY_URL=redis://127.0.0.1:6380/0

# --- Public URLs -------------------------------------------------------------
# Decal URLs are SCANNER_BASE_URL/s/<code>. Production: https://pkshd.de
SCANNER_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
OPS_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
API_PORT=4000
# api-ops binds here only (WireGuard interface in production).
OPS_API_HOST=127.0.0.1
OPS_API_PORT=4001

# --- Application secrets (generated locally; from SOPS/Infisical in prod) -----
DATA_KEY_V1=
BIDX_KEY=
BLOCK_KEY_CURRENT=
BLOCK_KEY_PREVIOUS=
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@parkshield.de

# --- Provider sandbox keys (fill in yourself; empty = local fake adapter) ----
# Stripe test mode: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# E-mail: sendgrid (Twilio's e-mail service, default) or brevo. Empty key = local dev inbox.
MAIL_PROVIDER=sendgrid
BREVO_API_KEY=
SENDGRID_API_KEY=
# global (api.sendgrid.com) or eu (api.eu.sendgrid.com, needs an EU subuser)
SENDGRID_REGION=global
MAIL_FROM=ParkShield <hallo@parkshield.de>
# WhatsApp: twilio (default) or 360dialog. Empty keys = local fake (messages in the dev inbox).
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp sender number in E.164 form, e.g. +4915123456789
TWILIO_WHATSAPP_FROM=
# SMS sender: alphanumeric sender ID (max. 11 chars, e.g. ParkShield), a Twilio number or MG... SID
TWILIO_SMS_FROM=
# Public https origin Twilio calls back (tunnel or real domain); empty = WEB_BASE_URL
TWILIO_WEBHOOK_BASE_URL=
# Content SIDs (HX...) of the approved templates, see docs/whatsapp-templates.md
TWILIO_CONTENT_PS_ALERT_DE=
TWILIO_CONTENT_PS_ALERT_EN=
TWILIO_CONTENT_PS_FOLLOWUP_DE=
TWILIO_CONTENT_PS_FOLLOWUP_EN=
TWILIO_CONTENT_PS_TEST_DE=
TWILIO_CONTENT_PS_TEST_EN=
TWILIO_CONTENT_PS_OTP_DE=
TWILIO_CONTENT_PS_OTP_EN=
# 360dialog (only with WHATSAPP_PROVIDER=360dialog)
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# Friendly Captcha (the web app needs the sitekey too, as NEXT_PUBLIC_…)
FRIENDLY_CAPTCHA_SITEKEY=
FRIENDLY_CAPTCHA_API_KEY=
NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=
# eu (default; Friendly Captcha Advanced plan, required in production) or global (local testing on smaller plans)
FRIENDLY_CAPTCHA_ENDPOINT=eu
# Print partner (chosen in Phase 0). Empty = local fake: print files land in .local/print-outbox
PRINT_PARTNER=
PRINT_OUTBOX_DIR=
# Optional
SENTRY_DSN=
UNLEASH_URL=
UNLEASH_API_TOKEN=
